rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para obtener el perfil del usuario logueado en base a su UID
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Colección de Usuarios
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles
      allow read: if request.auth != null;
      // PERMITIR CREACIÓN: Fundamental para que el nuevo usuario pueda guardar su perfil inicial
      allow create: if request.auth != null;
      // Solo el propio usuario o RH/Director pueden actualizar el perfil
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol in ['rh', 'rh_global', 'director']
      );
      // Evitar eliminación de usuarios
      allow delete: if false;
    }

    // Colección de Planes de Fortalecimiento
    match /planes/{planId} {
      // Reglas de lectura adaptadas para permitir queries optimizados por rol
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        resource.data.colaboradorUid == request.auth.uid ||
        resource.data.liderUid == request.auth.uid ||
        getUserData().rol == 'rh' ||
        getUserData().rol == 'rh_global' ||
        // Directores comerciales pueden ver por país o por región (especialmente en GT)
        (getUserData().rol == 'director' && (resource.data.pais == getUserData().pais || resource.data.region != '')) ||
        // Gerentes regionales ven su región
        (getUserData().rol == 'regional' && resource.data.region == getUserData().region) ||
        // Gerentes de zona ven su zona
        (getUserData().rol == 'zona' && resource.data.zona == getUserData().zona)
      );
      
      // Permitir la edición al creador del plan, al líder directo o a RH
      allow write: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        resource.data.liderUid == request.auth.uid ||
        getUserData().rol == 'rh' ||
        getUserData().rol == 'rh_global'
      );
      
      // Cualquier usuario autenticado puede crear planes
      allow create: if request.auth != null;
    }

    // Colección de Sesiones Uno a Uno (unoauno)
    match /unoauno/{planId} {
      // Reglas de lectura adaptadas para permitir queries optimizados por rol
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        resource.data.colaboradorUid == request.auth.uid ||
        resource.data.liderUid == request.auth.uid ||
        getUserData().rol == 'rh' ||
        getUserData().rol == 'rh_global' ||
        // Directores comerciales pueden ver por país o por región (especialmente en GT)
        (getUserData().rol == 'director' && (resource.data.pais == getUserData().pais || resource.data.region != '')) ||
        // Gerentes regionales ven su región
        (getUserData().rol == 'regional' && resource.data.region == getUserData().region) ||
        // Gerentes de zona ven su zona
        (getUserData().rol == 'zona' && resource.data.zona == getUserData().zona)
      );
      
      // Permitir la edición al creador del plan, al líder directo o a RH
      allow write: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        resource.data.liderUid == request.auth.uid ||
        getUserData().rol == 'rh' ||
        getUserData().rol == 'rh_global'
      );
      
      allow create: if request.auth != null;
    }

    // Colección de Notificaciones individuales
    match /{collectionName}/{notifId} {
      allow read, write: if request.auth != null && 
        collectionName == 'notificaciones_' + request.auth.uid;
    }

    // Colección de Correos encolados (Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if request.auth != null && 
        request.resource.data.to is list && 
        request.resource.data.message.subject.size() < 120;
      
      allow read, update, delete: if false;
    }
  }
}
